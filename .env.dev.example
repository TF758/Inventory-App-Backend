# Example environment configuration for local development.
# Copy to .env.dev and adjust values for your local setup.
# Avoid committing real secrets.

DJANGO_ENV=dev
APP_ENV=dev
DJANGO_SETTINGS_MODULE=inventory.settings.dev
DEBUG=True
DJANGO_RELOAD=1
DJANGO_SERVER=dev

SECRET_KEY=INSERT_YOUR_OWN_SECRET_KEY

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
FRONTEND_URL=http://localhost:5173
TIME_ZONE=America/St_Lucia

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=INSERT_YOUR_OWN_EMAIL_USER
EMAIL_HOST_PASSWORD=INSERT_YOUR_OWN_EMAIL_PASSWORD

DB_NAME=inventory
DB_USER=inventory
DB_PASSWORD=INSERT_YOUR_OWN_DB_PASSWORD
DB_HOST=db
DB_PORT=5432

POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=INSERT_YOUR_OWN_POSTGRES_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_CELERY=0
REDIS_DB_CHANNELS=1
REDIS_DB_REPORTS=2
REDIS_DB_CACHE=3

JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=5/min
THROTTLE_REFRESH=30/min
THROTTLE_EQUIPMENT=30/hour

LOG_LEVEL=INFO
LOG_TO_CONSOLE=True
LOG_TO_FILE=True
LOG_FILE_WHEN=midnight
LOG_FILE_INTERVAL=1
LOG_FILE_BACKUP_COUNT=30
LOG_ERROR_WHEN=midnight
LOG_ERROR_INTERVAL=1
LOG_ERROR_BACKUP_COUNT=30
SERVICE_NAME=api
