# Example environment configuration for production.
# Copy to .env.production and replace placeholder values before deployment.
# Avoid committing real secrets.

DJANGO_ENV=prod
APP_ENV=production
DJANGO_SETTINGS_MODULE=inventory.settings.prod
DEBUG=False
DJANGO_RELOAD=0
DJANGO_SERVER=asgi

SECRET_KEY=INSERT_YOUR_OWN_SECRET_KEY

ALLOWED_HOSTS=your-domain.com,www.your-domain.com,api.your-domain.com
FRONTEND_URL=https://your-domain.com
TIME_ZONE=America/St_Lucia

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=INSERT_YOUR_OWN_EMAIL_USER
EMAIL_HOST_PASSWORD=INSERT_YOUR_OWN_EMAIL_PASSWORD

DB_NAME=inventory_production
DB_USER=inventory
DB_PASSWORD=INSERT_YOUR_OWN_DB_PASSWORD
DB_HOST=db
DB_PORT=5432

POSTGRES_DB=inventory_production
POSTGRES_USER=inventory
POSTGRES_PASSWORD=INSERT_YOUR_OWN_POSTGRES_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_CELERY=0
REDIS_DB_CHANNELS=1
REDIS_DB_REPORTS=2
REDIS_DB_CACHE=3

JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com


# =====================================
# Durable file storage
# =====================================

# Use an S3-compatible bucket so API and Celery services share imports and
# generated reports across container replacements and multiple hosts.
STORAGE_BACKEND=s3
STORAGE_SHARED=True
AWS_STORAGE_BUCKET_NAME=inventory-production
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=
AWS_S3_USE_SSL=True
AWS_S3_VERIFY=True
AWS_ACCESS_KEY_ID=INSERT_YOUR_OWN_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=INSERT_YOUR_OWN_STORAGE_SECRET_KEY
MEDIA_STORAGE_PREFIX=media
REPORT_STORAGE_PREFIX=reports

# =====================================
# Security boundaries
# =====================================

PASSWORD_MIN_LENGTH=12
ENABLE_BASIC_AUTH=False
WEBSOCKET_ALLOW_QUERY_TOKEN=False
API_DOCS_ENABLED=False
API_DOCS_PUBLIC=False
METRICS_ALLOW_PUBLIC=False
# Leave blank to disable metrics, or set a long random scraper token.
METRICS_BEARER_TOKEN=

# =====================================
# API Throttling
# =====================================

THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=5/min
THROTTLE_REFRESH=30/min
THROTTLE_EQUIPMENT=30/hour

LOG_LEVEL=INFO
LOG_TO_CONSOLE=False
LOG_TO_FILE=True
LOG_FILE_WHEN=midnight
LOG_FILE_INTERVAL=1
LOG_FILE_BACKUP_COUNT=30
LOG_ERROR_WHEN=midnight
LOG_ERROR_INTERVAL=1
LOG_ERROR_BACKUP_COUNT=30
SERVICE_NAME=api
